{"name":"precompute","file":"src/core/include/math/hal/intnat/transformnat-impl.h","openfheVersion":"1.5.1","openfheCommit":"1306d14f8c26bb6150d3e6ad54f28dfe1007689e","sourceSha256":"e48274df5c1aac1badadc36eb7656d6c62594d519519b2adb1443d86d158e2a2","permalink":"https://github.com/openfheorg/openfhe-development/blob/1306d14f8c26bb6150d3e6ad54f28dfe1007689e/src/core/include/math/hal/intnat/transformnat-impl.h","startLine":713,"endLine":756,"regions":[{"name":"body","from":716,"to":756}],"lines":[{"n":713,"t":"template <typename VecType>"},{"n":714,"t":"void ChineseRemainderTransformFTTNat<VecType>::PreCompute(const IntType& rootOfUnity, const uint32_t cycloOrder,"},{"n":715,"t":"                                                          const IntType& modulus) {"},{"n":716,"t":"    auto ringDim   = (cycloOrder >> 1);"},{"n":717,"t":"    auto mapSearch = m_rootOfUnityReverseTableByModulus.find(modulus);"},{"n":718,"t":"    if (mapSearch == m_rootOfUnityReverseTableByModulus.end() || mapSearch->second.GetLength() != ringDim) {"},{"n":719,"t":"#pragma omp critical"},{"n":720,"t":"        {"},{"n":721,"t":"            IntType x(1), xinv(1);"},{"n":722,"t":"            uint32_t msb               = GetMSB(ringDim - 1);"},{"n":723,"t":"            IntType mu                 = modulus.ComputeMu();"},{"n":724,"t":"            IntType rootOfUnityInverse = rootOfUnity.ModInverse(modulus);"},{"n":725,"t":"            NativeInteger nModulus     = modulus.ConvertToInt();"},{"n":726,"t":"            VecType Table(ringDim, modulus);"},{"n":727,"t":"            VecType TableI(ringDim, modulus);"},{"n":728,"t":"            VecType preconTable(ringDim, nModulus);"},{"n":729,"t":"            VecType preconTableI(ringDim, nModulus);"},{"n":730,"t":"            for (uint32_t i = 0; i < ringDim; ++i) {"},{"n":731,"t":"                auto iinv         = ReverseBits(i, msb);"},{"n":732,"t":"                Table[iinv]       = x;"},{"n":733,"t":"                preconTable[iinv] = NativeInteger(x.ConvertToInt()).PrepModMulConst(nModulus);"},{"n":734,"t":"                x.ModMulEq(rootOfUnity, modulus, mu);"},{"n":735,"t":"                TableI[iinv]       = xinv;"},{"n":736,"t":"                preconTableI[iinv] = NativeInteger(xinv.ConvertToInt()).PrepModMulConst(nModulus);"},{"n":737,"t":"                xinv.ModMulEq(rootOfUnityInverse, modulus, mu);"},{"n":738,"t":"            }"},{"n":739,"t":"            m_rootOfUnityReverseTableByModulus[modulus]              = std::move(Table);"},{"n":740,"t":"            m_rootOfUnityInverseReverseTableByModulus[modulus]       = std::move(TableI);"},{"n":741,"t":"            m_rootOfUnityPreconReverseTableByModulus[modulus]        = std::move(preconTable);"},{"n":742,"t":"            m_rootOfUnityInversePreconReverseTableByModulus[modulus] = std::move(preconTableI);"},{"n":743,"t":""},{"n":744,"t":"            IntType coInv(1);"},{"n":745,"t":"            VecType TableCOI(msb + 1, modulus);"},{"n":746,"t":"            VecType preconTableCOI(msb + 1, nModulus);"},{"n":747,"t":"            for (uint32_t i = 0; i <= msb; ++i) {"},{"n":748,"t":"                TableCOI[i]       = coInv.ModInverse(modulus);"},{"n":749,"t":"                preconTableCOI[i] = NativeInteger(TableCOI[i].ConvertToInt()).PrepModMulConst(nModulus);"},{"n":750,"t":"                coInv <<= 1;"},{"n":751,"t":"            }"},{"n":752,"t":"            m_cycloOrderInverseTableByModulus[modulus]       = std::move(TableCOI);"},{"n":753,"t":"            m_cycloOrderInversePreconTableByModulus[modulus] = std::move(preconTableCOI);"},{"n":754,"t":"        }"},{"n":755,"t":"    }"},{"n":756,"t":"}"}]}
