{"name":"forward","file":"src/core/include/math/hal/intnat/transformnat-impl.h","openfheVersion":"1.5.1","openfheCommit":"1306d14f8c26bb6150d3e6ad54f28dfe1007689e","sourceSha256":"e48274df5c1aac1badadc36eb7656d6c62594d519519b2adb1443d86d158e2a2","permalink":"https://github.com/openfheorg/openfhe-development/blob/1306d14f8c26bb6150d3e6ad54f28dfe1007689e/src/core/include/math/hal/intnat/transformnat-impl.h","startLine":302,"endLine":374,"regions":[{"name":"prologue","from":322,"to":323},{"name":"main","from":324,"to":350},{"name":"peeledLast","from":351,"to":374}],"lines":[{"n":302,"t":"template <typename VecType>"},{"n":303,"t":"void NumberTheoreticTransformNat<VecType>::ForwardTransformToBitReverseInPlace(const VecType& rootOfUnityTable,"},{"n":304,"t":"                                                                               const VecType& preconRootOfUnityTable,"},{"n":305,"t":"                                                                               VecType* element) {"},{"n":306,"t":"    //"},{"n":307,"t":"    // NTT based on the Cooley-Tukey (CT) butterfly"},{"n":308,"t":"    // Inputs: element (vector of size n in standard ordering)"},{"n":309,"t":"    //         rootOfUnityTable (precomputed roots of unity in bit-reversed ordering)"},{"n":310,"t":"    // Output: NTT(element) in bit-reversed ordering"},{"n":311,"t":"    //"},{"n":312,"t":"    // for (m = 1, t = n, logt = log(t); m < n; m=2*m, t=t/2, --logt) do"},{"n":313,"t":"    //     for (i = 0; i < m; ++i) do"},{"n":314,"t":"    //         omega = rootOfUnityInverseTable[i + m]"},{"n":315,"t":"    //         for (j1 = (i << logt), j2 = (j1 + t); j1 < j2; ++j1) do"},{"n":316,"t":"    //             loVal = element[j1 + 0]"},{"n":317,"t":"    //             hiVal = element[j1 + t]*omega"},{"n":318,"t":"    //             element[j1 + 0] = (loVal + hiVal) mod modulus"},{"n":319,"t":"    //             element[j1 + t] = (loVal - hiVal) mod modulus"},{"n":320,"t":"    //"},{"n":321,"t":""},{"n":322,"t":"    const auto modulus{element->GetModulus()};"},{"n":323,"t":"    const uint32_t n(element->GetLength() >> 1);"},{"n":324,"t":"    for (uint32_t m{1}, t{n}, logt{GetMSB(t)}; m < n; m <<= 1, t >>= 1, --logt) {"},{"n":325,"t":"        for (uint32_t i{0}; i < m; ++i) {"},{"n":326,"t":"            auto omega{rootOfUnityTable[i + m]};"},{"n":327,"t":"            auto preconOmega{preconRootOfUnityTable[i + m]};"},{"n":328,"t":"            for (uint32_t j1{i << logt}, j2{j1 + t}; j1 < j2; ++j1) {"},{"n":329,"t":"                auto omegaFactor{(*element)[j1 + t]};"},{"n":330,"t":"                omegaFactor.ModMulFastConstEq(omega, modulus, preconOmega);"},{"n":331,"t":"                auto loVal{(*element)[j1 + 0]};"},{"n":332,"t":"#if defined(__GNUC__) && !defined(__clang__)","v":"pp"},{"n":333,"t":"                auto hiVal{loVal + omegaFactor};","v":"gcc"},{"n":334,"t":"                if (hiVal >= modulus)","v":"gcc"},{"n":335,"t":"                    hiVal -= modulus;","v":"gcc"},{"n":336,"t":"                if (loVal < omegaFactor)","v":"gcc"},{"n":337,"t":"                    loVal += modulus;","v":"gcc"},{"n":338,"t":"                loVal -= omegaFactor;","v":"gcc"},{"n":339,"t":"                (*element)[j1 + 0] = hiVal;","v":"gcc"},{"n":340,"t":"                (*element)[j1 + t] = loVal;","v":"gcc"},{"n":341,"t":"#else","v":"pp"},{"n":342,"t":"                // fixes Clang slowdown issue, but requires lowVal be less than modulus","v":"clang"},{"n":343,"t":"                (*element)[j1 + 0] += omegaFactor - (omegaFactor >= (modulus - loVal) ? modulus : 0);","v":"clang"},{"n":344,"t":"                if (omegaFactor > loVal)","v":"clang"},{"n":345,"t":"                    loVal += modulus;","v":"clang"},{"n":346,"t":"                (*element)[j1 + t] = loVal - omegaFactor;","v":"clang"},{"n":347,"t":"#endif","v":"pp"},{"n":348,"t":"            }"},{"n":349,"t":"        }"},{"n":350,"t":"    }"},{"n":351,"t":"    // peeled off last ntt stage for performance"},{"n":352,"t":"    for (uint32_t i{0}; i < (n << 1); i += 2) {"},{"n":353,"t":"        auto omegaFactor{(*element)[i + 1]};"},{"n":354,"t":"        auto omega{rootOfUnityTable[(i >> 1) + n]};"},{"n":355,"t":"        auto preconOmega{preconRootOfUnityTable[(i >> 1) + n]};"},{"n":356,"t":"        omegaFactor.ModMulFastConstEq(omega, modulus, preconOmega);"},{"n":357,"t":"        auto loVal{(*element)[i + 0]};"},{"n":358,"t":"#if defined(__GNUC__) && !defined(__clang__)","v":"pp"},{"n":359,"t":"        auto hiVal{loVal + omegaFactor};","v":"gcc"},{"n":360,"t":"        if (hiVal >= modulus)","v":"gcc"},{"n":361,"t":"            hiVal -= modulus;","v":"gcc"},{"n":362,"t":"        if (loVal < omegaFactor)","v":"gcc"},{"n":363,"t":"            loVal += modulus;","v":"gcc"},{"n":364,"t":"        loVal -= omegaFactor;","v":"gcc"},{"n":365,"t":"        (*element)[i + 0] = hiVal;","v":"gcc"},{"n":366,"t":"        (*element)[i + 1] = loVal;","v":"gcc"},{"n":367,"t":"#else","v":"pp"},{"n":368,"t":"        (*element)[i + 0] += omegaFactor - (omegaFactor >= (modulus - loVal) ? modulus : 0);","v":"clang"},{"n":369,"t":"        if (omegaFactor > loVal)","v":"clang"},{"n":370,"t":"            loVal += modulus;","v":"clang"},{"n":371,"t":"        (*element)[i + 1] = loVal - omegaFactor;","v":"clang"},{"n":372,"t":"#endif","v":"pp"},{"n":373,"t":"    }"},{"n":374,"t":"}"}]}
