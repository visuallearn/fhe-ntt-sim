{"name":"inverse","file":"src/core/include/math/hal/intnat/transformnat-impl.h","openfheVersion":"1.5.1","openfheCommit":"1306d14f8c26bb6150d3e6ad54f28dfe1007689e","sourceSha256":"e48274df5c1aac1badadc36eb7656d6c62594d519519b2adb1443d86d158e2a2","permalink":"https://github.com/openfheorg/openfhe-development/blob/1306d14f8c26bb6150d3e6ad54f28dfe1007689e/src/core/include/math/hal/intnat/transformnat-impl.h","startLine":511,"endLine":625,"regions":[{"name":"prologue","from":534,"to":541},{"name":"peeledFirst","from":542,"to":567},{"name":"inner","from":568,"to":596},{"name":"peeledLast","from":597,"to":621},{"name":"scale","from":622,"to":625}],"lines":[{"n":511,"t":"template <typename VecType>"},{"n":512,"t":"void NumberTheoreticTransformNat<VecType>::InverseTransformFromBitReverseInPlace("},{"n":513,"t":"    const VecType& rootOfUnityInverseTable, const VecType& preconRootOfUnityInverseTable, const IntType& cycloOrderInv,"},{"n":514,"t":"    const IntType& preconCycloOrderInv, VecType* element) {"},{"n":515,"t":"    //"},{"n":516,"t":"    // INTT based on the Gentleman-Sande (GS) butterfly"},{"n":517,"t":"    // Inputs: element (vector of size n in bit-reversed ordering)"},{"n":518,"t":"    //         rootOfUnityInverseTable (precomputed roots of unity in bit-reversed ordering)"},{"n":519,"t":"    //         cycloOrderInv (n inverse)"},{"n":520,"t":"    // Output: INTT(element) in standard ordering"},{"n":521,"t":"    //"},{"n":522,"t":"    // for (m = n/2, t = 1, logt = 1; m >= 1; m=m/2, t=2*t, ++logt) do"},{"n":523,"t":"    //     for (i = 0; i < m; ++i) do"},{"n":524,"t":"    //         omega = rootOfUnityInverseTable[i + m]"},{"n":525,"t":"    //         for (j1 = (i << logt), j2 = (j1 + t); j1 < j2; ++j1) do"},{"n":526,"t":"    //             loVal = element[j1 + 0]"},{"n":527,"t":"    //             hiVal = element[j1 + t]"},{"n":528,"t":"    //             element[j1 + 0] = (loVal + hiVal) mod modulus"},{"n":529,"t":"    //             element[j1 + t] = (loVal - hiVal)*omega mod modulus"},{"n":530,"t":"    // for (i = 0; i < n; ++i) do"},{"n":531,"t":"    //     element[i] = element[i]*cycloOrderInv mod modulus"},{"n":532,"t":"    //"},{"n":533,"t":""},{"n":534,"t":"    auto modulus{element->GetModulus()};"},{"n":535,"t":"    uint32_t n(element->GetLength());"},{"n":536,"t":""},{"n":537,"t":"    // precomputed omega[bitreversed(1)] * (n inverse). used in final stage of intt."},{"n":538,"t":"    auto omega1Inv{rootOfUnityInverseTable[1].ModMulFastConst(cycloOrderInv, modulus, preconCycloOrderInv)};"},{"n":539,"t":"    auto preconOmega1Inv{omega1Inv.PrepModMulConst(modulus)};"},{"n":540,"t":""},{"n":541,"t":"    if (n > 2) {"},{"n":542,"t":"        // peeled off first stage for performance"},{"n":543,"t":"        for (uint32_t i{0}; i < n; i += 2) {"},{"n":544,"t":"            auto omega{rootOfUnityInverseTable[(i + n) >> 1]};"},{"n":545,"t":"            auto preconOmega{preconRootOfUnityInverseTable[(i + n) >> 1]};"},{"n":546,"t":"            auto loVal{(*element)[i + 0]};"},{"n":547,"t":"            auto hiVal{(*element)[i + 1]};"},{"n":548,"t":"#if defined(__GNUC__) && !defined(__clang__)","v":"pp"},{"n":549,"t":"            auto omegaFactor{loVal};","v":"gcc"},{"n":550,"t":"            if (omegaFactor < hiVal)","v":"gcc"},{"n":551,"t":"                omegaFactor += modulus;","v":"gcc"},{"n":552,"t":"            omegaFactor -= hiVal;","v":"gcc"},{"n":553,"t":"            loVal += hiVal;","v":"gcc"},{"n":554,"t":"            if (loVal >= modulus)","v":"gcc"},{"n":555,"t":"                loVal -= modulus;","v":"gcc"},{"n":556,"t":"            omegaFactor.ModMulFastConstEq(omega, modulus, preconOmega);","v":"gcc"},{"n":557,"t":"            (*element)[i + 0] = loVal;","v":"gcc"},{"n":558,"t":"            (*element)[i + 1] = omegaFactor;","v":"gcc"},{"n":559,"t":"#else","v":"pp"},{"n":560,"t":"            auto omegaFactor{loVal + (hiVal > loVal ? modulus : 0) - hiVal};","v":"clang"},{"n":561,"t":"            loVal += hiVal - (hiVal >= (modulus - loVal) ? modulus : 0);","v":"clang"},{"n":562,"t":"            (*element)[i + 0] = loVal;","v":"clang"},{"n":563,"t":"            omegaFactor.ModMulFastConstEq(omega, modulus, preconOmega);","v":"clang"},{"n":564,"t":"            (*element)[i + 1] = omegaFactor;","v":"clang"},{"n":565,"t":"#endif","v":"pp"},{"n":566,"t":"        }"},{"n":567,"t":"    }"},{"n":568,"t":"    // inner stages"},{"n":569,"t":"    for (uint32_t m{n >> 2}, t{2}, logt{2}; m > 1; m >>= 1, t <<= 1, ++logt) {"},{"n":570,"t":"        for (uint32_t i{0}; i < m; ++i) {"},{"n":571,"t":"            auto omega{rootOfUnityInverseTable[i + m]};"},{"n":572,"t":"            auto preconOmega{preconRootOfUnityInverseTable[i + m]};"},{"n":573,"t":"            for (uint32_t j1{i << logt}, j2{j1 + t}; j1 < j2; ++j1) {"},{"n":574,"t":"                auto loVal{(*element)[j1 + 0]};"},{"n":575,"t":"                auto hiVal{(*element)[j1 + t]};"},{"n":576,"t":"#if defined(__GNUC__) && !defined(__clang__)","v":"pp"},{"n":577,"t":"                auto omegaFactor{loVal};","v":"gcc"},{"n":578,"t":"                if (omegaFactor < hiVal)","v":"gcc"},{"n":579,"t":"                    omegaFactor += modulus;","v":"gcc"},{"n":580,"t":"                omegaFactor -= hiVal;","v":"gcc"},{"n":581,"t":"                loVal += hiVal;","v":"gcc"},{"n":582,"t":"                if (loVal >= modulus)","v":"gcc"},{"n":583,"t":"                    loVal -= modulus;","v":"gcc"},{"n":584,"t":"                omegaFactor.ModMulFastConstEq(omega, modulus, preconOmega);","v":"gcc"},{"n":585,"t":"                (*element)[j1 + 0] = loVal;","v":"gcc"},{"n":586,"t":"                (*element)[j1 + t] = omegaFactor;","v":"gcc"},{"n":587,"t":"#else","v":"pp"},{"n":588,"t":"                (*element)[j1 + 0] += hiVal - (hiVal >= (modulus - loVal) ? modulus : 0);","v":"clang"},{"n":589,"t":"                auto omegaFactor = loVal + (hiVal > loVal ? modulus : 0) - hiVal;","v":"clang"},{"n":590,"t":"                omegaFactor.ModMulFastConstEq(omega, modulus, preconOmega);","v":"clang"},{"n":591,"t":"                (*element)[j1 + t] = omegaFactor;","v":"clang"},{"n":592,"t":"#endif","v":"pp"},{"n":593,"t":"            }"},{"n":594,"t":"        }"},{"n":595,"t":"    }"},{"n":596,"t":""},{"n":597,"t":"    // peeled off final stage to implement optimization where n/2 scalar multiplies"},{"n":598,"t":"    // by (n inverse) are incorporated into the omegaFactor calculation."},{"n":599,"t":"    // Please see https://github.com/openfheorg/openfhe-development/issues/872 for details."},{"n":600,"t":"    uint32_t j2{n >> 1};"},{"n":601,"t":"    for (uint32_t j1{0}; j1 < j2; ++j1) {"},{"n":602,"t":"        auto loVal{(*element)[j1]};"},{"n":603,"t":"        auto hiVal{(*element)[j1 + j2]};"},{"n":604,"t":"#if defined(__GNUC__) && !defined(__clang__)","v":"pp"},{"n":605,"t":"        auto omegaFactor{loVal};","v":"gcc"},{"n":606,"t":"        if (omegaFactor < hiVal)","v":"gcc"},{"n":607,"t":"            omegaFactor += modulus;","v":"gcc"},{"n":608,"t":"        omegaFactor -= hiVal;","v":"gcc"},{"n":609,"t":"        loVal += hiVal;","v":"gcc"},{"n":610,"t":"        if (loVal >= modulus)","v":"gcc"},{"n":611,"t":"            loVal -= modulus;","v":"gcc"},{"n":612,"t":"        omegaFactor.ModMulFastConstEq(omega1Inv, modulus, preconOmega1Inv);","v":"gcc"},{"n":613,"t":"        (*element)[j1 + 0]  = loVal;","v":"gcc"},{"n":614,"t":"        (*element)[j1 + j2] = omegaFactor;","v":"gcc"},{"n":615,"t":"#else","v":"pp"},{"n":616,"t":"        (*element)[j1] += hiVal - (hiVal >= (modulus - loVal) ? modulus : 0);","v":"clang"},{"n":617,"t":"        auto omegaFactor = loVal + (hiVal > loVal ? modulus : 0) - hiVal;","v":"clang"},{"n":618,"t":"        omegaFactor.ModMulFastConstEq(omega1Inv, modulus, preconOmega1Inv);","v":"clang"},{"n":619,"t":"        (*element)[j1 + j2] = omegaFactor;","v":"clang"},{"n":620,"t":"#endif","v":"pp"},{"n":621,"t":"    }"},{"n":622,"t":"    // perform remaining n/2 scalar multiplies by (n inverse)"},{"n":623,"t":"    for (uint32_t i = 0; i < j2; ++i)"},{"n":624,"t":"        (*element)[i].ModMulFastConstEq(cycloOrderInv, modulus, preconCycloOrderInv);"},{"n":625,"t":"}"}]}
